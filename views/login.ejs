<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>AuthFlow</title>
</head>
<body>
    <div class="w-full h-screen p-10 bg-zinc-900 text-white">
        <h1 class="text-3xl mx-2 my-4">Login</h1>
        <form action="/login" method="post">
            <input type="email" placeholder="email" name="email" class="rounded-md outline-none bg-transparent border-2 border-zinc-600 px-3 py-2">
            <input type="password" placeholder="password" name="password" class="rounded-md outline-none bg-transparent border-2 border-zinc-600 px-3 py-2">
            <input type="submit" value="Login" class="bg-blue-600 px-6 py-2 rounded-xl">
        </form>
    </div>
</body>
</html>